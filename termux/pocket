#!/data/data/com.termux/files/usr/bin/sh
set -eu

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
ROOT="$PREFIX/share/pocket"

export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"

case "${1:-}" in
  web)
    shift
    exec python3 "$ROOT/pocket_web.py" "$@"
    ;;
  bootstrap)
    shift
    exec sh "$ROOT/bootstrap/install.sh" "$@"
    ;;
  version)
    exec python3 "$ROOT/pocket_version.py"
    ;;
  *)
    exec python3 "$ROOT/pocket_client.py" "$@"
    ;;
esac
