#!/data/data/com.termux/files/usr/bin/sh
set -eu

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if [ -f "$SCRIPT_DIR/pocket_client.py" ]; then
    ROOT="$SCRIPT_DIR"
else
    ROOT="$PREFIX/share/pocket"
fi

export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"

case "${1:-}" in
  web)
    shift
    exec python3 "$ROOT/pocket_web.py" "$@"
    ;;
  bootstrap)
    shift
    exec sh "$ROOT/bootstrap/install.sh" "$@"
    ;;
  version)
    exec python3 "$ROOT/pocket_version.py"
    ;;
  *)
    exec python3 "$ROOT/pocket_client.py" "$@"
    ;;
esac
